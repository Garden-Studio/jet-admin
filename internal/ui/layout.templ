package ui

import (
	"github.com/garden-studio/jet-admin/internal/ui/components"
	"github.com/garden-studio/jet-admin/internal/ui/components/alert"
	"github.com/garden-studio/jet-admin/internal/ui/components/breadcrumb"
	"github.com/garden-studio/jet-admin/internal/ui/components/button"
	"github.com/garden-studio/jet-admin/internal/ui/components/icon"
	"github.com/garden-studio/jet-admin/internal/ui/components/separator"
	"github.com/garden-studio/jet-admin/internal/ui/components/sidebar"
)

// page is the document around every page: the models' sidebar, the header
// with the breadcrumbs and the session, and the flash message of the last
// redirect.
//
// Who drives what: shadcn-templ's script owns the sidebar (the sheet it
// becomes on narrow screens) and the delete dialog's opening, closing and
// focus; Datastar owns every round trip, and only ever patches #flash,
// #changelist, #changelist-params, #change-form, #login-error and #dialog,
// none of which holds an element the component script keeps state on.
templ page(c Chrome) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>{ pageTitle(c) }</title>
			<link rel="stylesheet" href={ c.StaticURL("admin.css") }/>
			for _, href := range c.Styles {
				<link rel="stylesheet" href={ href }/>
			}
			<script type="module" nonce={ templ.GetNonce(ctx) } src={ c.StaticURL("datastar.js") }></script>
			@components.Scripts(c.Base)
		</head>
		<body class="min-h-svh bg-background text-xs/relaxed text-foreground antialiased">
			<a class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:ring-2 focus:ring-ring" href="#content">Skip to content</a>
			if len(c.Nav) > 0 {
				@sidebar.Provider(sidebar.ProviderProps{ID: "admin-sidebar", DisableDefaultOpen: c.NavCollapsed}) {
					@navSidebar(c)
					@sidebar.Inset(sidebar.InsetProps{Class: "min-w-0"}) {
						@topbar(c)
						@content(c) {
							{ children... }
						}
					}
				}
			} else {
				@topbar(c)
				@content(c) {
					{ children... }
				}
			}
			<div id="dialog"></div>
		</body>
	</html>
}

templ content(c Chrome) {
	<main id="content" tabindex="-1" class="mx-auto flex w-full max-w-screen-2xl flex-1 flex-col gap-4 p-4 outline-none md:p-6">
		@flash(c.Flash)
		{ children... }
	</main>
}

// navSidebar lists the models by group. Below md it is a sheet the trigger
// in the header opens, which takes JavaScript; without it the header's site
// title leads to the index, which lists the same models.
templ navSidebar(c Chrome) {
	@sidebar.Sidebar(sidebar.Props{Collapsible: navCollapsible(c), Attributes: templ.Attributes{"aria-label": "Models"}}) {
		@sidebar.Header() {
			<a href={ c.Base + "/" } class="flex h-8 items-center gap-2 rounded-md px-2 text-sm font-semibold tracking-tight outline-none hover:bg-sidebar-accent focus-visible:ring-2 focus-visible:ring-sidebar-ring group-data-[collapsible=icon]:size-8 group-data-[collapsible=icon]:justify-center group-data-[collapsible=icon]:p-0" title={ c.SiteTitle }>
				@icon.Database(icon.Props{Class: "size-4 shrink-0", Attributes: templ.Attributes{"aria-hidden": "true"}})
				<span class="truncate group-data-[collapsible=icon]:hidden">{ c.SiteTitle }</span>
			</a>
		}
		@sidebar.Content() {
			<nav aria-label="Models">
				for _, group := range c.Nav {
					// Groups read as blocks by the room between them.
					@sidebar.Group(sidebar.GroupProps{Class: "not-first:mt-3"}) {
						@sidebar.GroupLabel(sidebar.GroupLabelProps{Class: "text-sm font-medium"}) {
							{ group.Name }
						}
						@sidebar.GroupContent() {
							@sidebar.Menu(sidebar.MenuProps{Class: "gap-0.5"}) {
								for _, m := range group.Models {
									@sidebar.MenuItem() {
										@sidebar.MenuButton(sidebar.MenuButtonProps{Class: "h-9 text-sm [&_svg]:size-[1.125rem]", Href: m.URL, Tooltip: m.Plural, IsActive: m.Slug == c.Active, Attributes: ariaCurrentAttr(m.Slug == c.Active)}) {
											if m.Icon != "" {
												@icon.Icon(m.Icon)(icon.Props{Attributes: templ.Attributes{"aria-hidden": "true"}})
											}
											<span>{ m.Plural }</span>
										}
										if m.AddURL != "" {
											@sidebar.MenuAction(sidebar.MenuActionProps{Href: m.AddURL, ShowOnHover: m.Slug != c.Active, Attributes: templ.Attributes{"aria-label": "Add " + m.Plural, "title": "Add " + m.Plural}}) {
												@icon.Plus(icon.Props{Attributes: templ.Attributes{"aria-hidden": "true"}})
											}
										}
									}
								}
							}
						}
					}
				}
			</nav>
		}
	}
}

// topbar is the header: the trigger that folds the sidebar (a sheet on
// narrow screens), the breadcrumbs and who is signed in.
templ topbar(c Chrome) {
	<header class="sticky top-0 z-10 flex h-12 shrink-0 items-center gap-2 border-b bg-background/95 px-4 backdrop-blur supports-backdrop-filter:bg-background/80 md:px-6">
		if len(c.Nav) > 0 {
			@sidebar.Trigger(sidebar.TriggerProps{Class: "-ml-1 noscript:hidden"})
			@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "mr-1 data-vertical:h-4 data-vertical:self-center noscript:hidden"})
		}
		if len(c.Crumbs) == 0 {
			<a href={ c.Base + "/" } class={ "text-sm font-semibold tracking-tight", templ.KV("md:hidden", len(c.Nav) > 0) }>{ c.SiteTitle }</a>
		} else {
			@breadcrumb.Breadcrumb(breadcrumb.Props{Class: "min-w-0"}) {
				@breadcrumb.List(breadcrumb.ListProps{Class: "flex-nowrap"}) {
					for i, crumb := range c.Crumbs {
						if i > 0 {
							@breadcrumb.Separator(breadcrumb.SeparatorProps{Class: crumbNarrow(i, len(c.Crumbs))})
						}
						@breadcrumb.Item(breadcrumb.ItemProps{Class: "min-w-0 " + crumbNarrow(i, len(c.Crumbs))}) {
							if crumb.URL != "" {
								@breadcrumb.Link(breadcrumb.LinkProps{Href: crumb.URL, Class: "truncate"}) {
									{ crumb.Label }
								}
							} else {
								@breadcrumb.Page(breadcrumb.ItemProps{Class: "truncate"}) {
									{ crumb.Label }
								}
							}
						}
					}
				}
			}
		}
		if c.User != "" {
			<div class="ml-auto flex shrink-0 items-center gap-1">
				<span class="hidden text-muted-foreground sm:inline"><span class="sr-only">Signed in as </span>{ c.User }</span>
				if c.LogoutURL != "" {
					<form method="post" action={ c.LogoutURL } class="m-0">
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
							@icon.LogOut(icon.Props{Attributes: templ.Attributes{"aria-hidden": "true", "data-icon": "inline-start"}})
							Log out
						}
					</form>
				}
			</div>
		}
	</header>
}

// flash is the message of the last redirect, patched on its own after a
// Datastar request.
templ flash(f *Flash) {
	<div id="flash" aria-live="polite" class="empty:hidden">
		if f != nil {
			@alert.Alert(alert.Props{Variant: flashVariant(f), Attributes: templ.Attributes{"role": flashRole(f)}}) {
				if f.Error {
					@icon.CircleAlert(icon.Props{Attributes: templ.Attributes{"aria-hidden": "true"}})
				} else {
					@icon.CircleCheck(icon.Props{Attributes: templ.Attributes{"aria-hidden": "true"}})
				}
				@alert.Description() {
					{ f.Text }
				}
			}
		}
	</div>
}

// Flash patches the message area alone.
templ FlashFragment(f *Flash) {
	@flash(f)
}

// cell draws one value.
templ cell(c Cell) {
	switch c.Kind {
		case CellNull:
			<span class="text-muted-foreground" aria-label="empty">—</span>
		case CellBool:
			if c.Bool {
				@icon.Check(icon.Props{Class: "size-4 text-foreground", Attributes: templ.Attributes{"role": "img", "aria-label": "yes"}})
			} else {
				@icon.X(icon.Props{Class: "size-4 text-muted-foreground", Attributes: templ.Attributes{"role": "img", "aria-label": "no"}})
			}
		case CellMuted:
			<span class="text-muted-foreground">{ c.Text }</span>
		default:
			if c.Href != "" {
				<a href={ c.Href } class={ "font-medium underline-offset-4 hover:underline", templ.KV("font-mono", c.Mono) } title={ c.Title }>{ c.Text }</a>
			} else if c.Title != "" {
				<span class={ templ.KV("font-mono", c.Mono) } title={ c.Title }>{ c.Text }</span>
			} else {
				<span class={ templ.KV("font-mono", c.Mono) }>{ c.Text }</span>
			}
	}
	if c.Note != "" {
		<span class="ml-1.5 text-muted-foreground">{ c.Note }</span>
	}
}

// MessagePage is a page that only says something: not found, forbidden.
templ Message(p MessagePage) {
	@page(p.Chrome) {
		@emptyState(p.Heading, p.Text, true) {
			@button.Button(button.Props{Href: p.Chrome.Base + "/", Variant: button.VariantOutline}) {
				Back to the index
			}
		}
	}
}

// navCollapsible folds the sidebar to its icons when every model has one, and
// hides it whole otherwise: a rail with blank rows would say nothing.
func navCollapsible(c Chrome) sidebar.Collapsible {
	if c.NavIcons() {
		return sidebar.CollapsibleIcon
	}
	return sidebar.CollapsibleOffcanvas
}
