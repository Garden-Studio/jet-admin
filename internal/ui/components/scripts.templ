package components

// Scripts renders the one script tag that loads the component JS bundle.
// Render it once in the layout <head>. The URL comes from scripts_bundle.go.
//
// jet-admin: base is the admin's BasePath, which the host chooses, so the
// bundle's path is prefixed with it.
templ Scripts(base string) {
	<script defer nonce={ templ.GetNonce(ctx) } src={ base + bundleSrc }></script>
}
