package nativeselect

import (
	"github.com/garden-studio/jet-admin/internal/ui/components/icon"
	"github.com/garden-studio/jet-admin/internal/ui/utils"
)

type Size string

const (
	SizeSm      Size = "sm"
	SizeDefault Size = "default"
)

// Props are the select element's props shadcn's NativeSelect passes on, plus
// its Size. Class styles the wrapper, ID and Attributes land on the select.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Size       Size
	Name       string
	Disabled   bool
	Required   bool
}

type OptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string
	Disabled   bool
	Selected   bool
}

type OptGroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Label      string
	Disabled   bool
}

// jet-admin: the text is 16px (sm 14px) and the heights h-9/h-8, not mira's
// 12px/10px and h-7/h-6, to line up with the buttons.
templ NativeSelect(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Size == "" {
		{{ p.Size = SizeDefault }}
	}
	<div
		class={ utils.CN("group/native-select relative w-fit has-[select:disabled]:opacity-50", p.Class) }
		data-slot="native-select-wrapper"
		data-size={ string(p.Size) }
	>
		<select
			data-slot="native-select"
			data-size={ string(p.Size) }
			class="border-input bg-input/20 placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 dark:hover:bg-input/50 focus-visible:border-ring focus-visible:ring-ring/30 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 h-9 w-full min-w-0 appearance-none rounded-md border py-0.5 pr-6 pl-2.5 text-sm/5 transition-colors select-none focus-visible:ring-2 aria-invalid:ring-2 data-[size=sm]:h-8 data-[size=sm]:text-xs/5 outline-none disabled:pointer-events-none disabled:cursor-not-allowed"
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Name != "" {
				name={ p.Name }
			}
			disabled?={ p.Disabled }
			required?={ p.Required }
			{ p.Attributes... }
		>
			{ children... }
		</select>
		@icon.ChevronDown(icon.Props{
			Class:      "text-muted-foreground top-1/2 right-1.5 size-3.5 -translate-y-1/2 group-data-[size=sm]/native-select:size-3 group-data-[size=sm]/native-select:-translate-y-[calc(--spacing(1.25))] pointer-events-none absolute select-none",
			Attributes: templ.Attributes{"aria-hidden": "true", "data-slot": "native-select-icon"},
		})
	</div>
}

templ Option(props ...OptionProps) {
	{{ var p OptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<option
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="native-select-option"
		class={ utils.CN("bg-[Canvas] text-[CanvasText]", p.Class) }
		value={ p.Value }
		disabled?={ p.Disabled }
		selected?={ p.Selected }
		{ p.Attributes... }
	>
		{ children... }
	</option>
}

templ OptGroup(props ...OptGroupProps) {
	{{ var p OptGroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<optgroup
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="native-select-optgroup"
		class={ utils.CN("bg-[Canvas] text-[CanvasText]", p.Class) }
		if p.Label != "" {
			label={ p.Label }
		}
		disabled?={ p.Disabled }
		{ p.Attributes... }
	>
		{ children... }
	</optgroup>
}
